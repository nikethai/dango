{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dango",
  "version": "1.7.0",
  "identifier": "io.github.nikethai.dango",
  "build": {
    "beforeDevCommand": "pnpm start:renderer",
    "beforeBuildCommand": "pnpm build:renderer && pnpm delete-sourcemaps",
    "devUrl": "http://localhost:1212",
    "frontendDist": "../release/app/dist/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dango",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "maximized": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": [
      "sidecars/browser-host/index.mjs",
      "sidecars/browser-host/package.json"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
